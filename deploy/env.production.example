# Production .env for the Django backend on EC2.
# Copy this to backend/.env on the server and fill in real values.

# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

DJANGO_DEBUG=False

# Your EC2 public IP (and/or domain). Comma-separated, no scheme.
DJANGO_ALLOWED_HOSTS=YOUR_EC2_PUBLIC_IP,127.0.0.1

# Needed so the Django admin login works behind Nginx. Include the scheme.
CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# Frontend and API are served from the same origin via Nginx, so CORS isn't
# required. Left here only for completeness.
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

DEFAULT_LOW_STOCK_THRESHOLD=5
